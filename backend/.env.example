# Copia este archivo como .env y llena tus valores. Nunca subas .env al repo.

NODE_ENV=development
PORT=3000
# URL del front (Vite) para CORS
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=multicasa
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Contraseña del admin de prueba que crean los seeders (admin@multicasa.com).
# Si se deja vacía se usa Admin123!
SEED_ADMIN_PASSWORD=

# Contador de visitas (issue #12): texto secreto que se mezcla con IP + navegador antes del
# hash SHA-256 del visitante. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VISITAS_SALT=

# Login de administradores (issue #9)
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Búsqueda por radio (issue #13): C.P. o ciudad -> coordenadas con Nominatim (OpenStreetMap).
# Primero se busca en las casas de la BD; Nominatim solo para C.P./ciudades que no estén ahí.
# Nominatim pide un User-Agent que identifique la app (de preferencia con un correo de contacto).
GEOCODING_HABILITADO=true
GEOCODING_USER_AGENT=MultiCasa/1.0 (proyecto escolar; tu-correo@ejemplo.com)

# Correo del formulario de contacto (issue #14)
# Con Gmail: MAIL_HOST=smtp.gmail.com, MAIL_USER=tu cuenta y MAIL_PASSWORD = "contraseña de
# aplicación" de 16 letras (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones).
# Sin MAIL_HOST los mensajes se guardan en la BD pero no sale ningún correo (útil en desarrollo).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# A quién le llegan los mensajes del formulario (el correo de la inmobiliaria)
MAIL_TO=
# Remitente que se muestra; si se deja vacío se usa MAIL_USER
MAIL_FROM="MultiCasa <tu-cuenta@gmail.com>"
